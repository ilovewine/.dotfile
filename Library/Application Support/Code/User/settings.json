{
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash",
    },
    "zsh": {
      "path": "/usr/bin/zsh",
      "icon": "tools",
    },
  },
  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash",
    },
    "zsh": {
      "path": "/bin/zsh",
      "args": ["-l"],
      "icon": "terminal-linux",
    },
  },
  "terminal.integrated.profiles.windows": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash",
    },
    "zsh": {
      "path": "/usr/bin/zsh",
      "icon": "tools",
    },
  },
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.windows": "zsh",
  "security.workspace.trust.untrustedFiles": "open",
  "editor.fontFamily": "\"JetBrains Mono\", monospace",
  "editor.fontSize": 15,
  "editor.fontLigatures": true,
  "git.autofetch": true,
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.format.enable": true,
  "prettier.vueIndentScriptAndStyle": true,
  "git.allowForcePush": true,
  "git.confirmForcePush": false,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "files.autoSave": "onFocusChange",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "editor.linkedEditing": true,
  "git.fetchOnPull": true,
  "githubIssues.queries": [
    {
      "label": "My Issues",
      "query": "default",
    },
    {
      "label": "Created Issues",
      "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc",
    },
    {
      "label": "Recent Issues",
      "query": "state:open repo:${owner}/${repository} sort:updated-desc",
    },
  ],
  "terminal.integrated.customGlyphs": false,
  "editor.wordWrap": "bounded",
  "cSpell.userWords": [
    "CENTISECOND",
    "CENTISECONDS",
    "composables",
    "Contentful",
    "pomodoro",
    "Spinlock",
    "typecheck",
    "VITE",
  ],
  "terminal.integrated.fontFamily": "JetBrains Mono, monospace",
  "terminal.integrated.env.linux": {
    "LD_PRELOAD": null,
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "explorer.autoReveal": "focusNoScroll",
  "yaml.schemas": {
    "file:///home/codeist/.vscode/extensions/atlassian.atlascode-3.0.10/resources/schemas/pipelines-schema.json": "bitbucket-pipelines.yml",
  },
  "redhat.telemetry.enabled": false,
  "git.autofetchPeriod": 60,
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "remote.SSH.remotePlatform": {
    "sandbox.m3kwgx.csb": "linux",
  },
  "editor.inlineSuggest.showToolbar": "always",
  "editor.occurrencesHighlight": "multiFile",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
  },
  "svelte.enable-ts-plugin": true,
  "workbench.tree.enableStickyScroll": true,
  "json.schemas": [],
  "gitProjectManager.baseProjectsFolders": ["~/Desktop/projects"],
  "workbench.editorAssociations": {
    "*.pdf": "latex-workshop-pdf-hook",
    "*.svg": "default",
  },
  "svg.preview.mode": "svg",
  "files.autoSaveWhenNoErrors": true,
  "explorer.confirmPasteNative": false,
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "editor.formatOnSave": true,
  "workbench.iconTheme": "material-icon-theme",
  "editor.mouseWheelZoom": true,
  "terminal.integrated.mouseWheelZoom": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
  },
  "search.followSymlinks": false,
  "diffEditor.codeLens": true,
  "editor.suggest.snippetsPreventQuickSuggestions": true,
  "rust-analyzer.completion.snippets.custom": {
    "Ok": {
      "postfix": "ok",
      "body": "Ok(${receiver})",
      "description": "Wrap the expression in a `Result::Ok`",
      "scope": "expr",
    },
    "Box::pin": {
      "postfix": "pinbox",
      "body": "Box::pin(${receiver})",
      "requires": "std::boxed::Box",
      "description": "Put the expression into a pinned `Box`",
      "scope": "expr",
    },
    "Arc::new": {
      "postfix": "arc",
      "body": "Arc::new(${receiver})",
      "requires": "std::sync::Arc",
      "description": "Put the expression into an `Arc`",
      "scope": "expr",
    },
    "Some": {
      "postfix": "some",
      "body": "Some(${receiver})",
      "description": "Wrap the expression in an `Option::Some`",
      "scope": "expr",
    },
    "Err": {
      "postfix": "err",
      "body": "Err(${receiver})",
      "description": "Wrap the expression in a `Result::Err`",
      "scope": "expr",
    },
    "Rc::new": {
      "postfix": "rc",
      "body": "Rc::new(${receiver})",
      "requires": "std::rc::Rc",
      "description": "Put the expression into an `Rc`",
      "scope": "expr",
    },
  },
  "path-autocomplete.transformations": [],
  "window.zoomPerWindow": false,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    "/var/folders/b3/x66hsbk912qcqc4_nrlwngd40000gn/T/postman-collections-post-response.instructions.md": true,
    "/var/folders/b3/x66hsbk912qcqc4_nrlwngd40000gn/T/postman-collections-pre-request.instructions.md": true,
    "/var/folders/b3/x66hsbk912qcqc4_nrlwngd40000gn/T/postman-folder-post-response.instructions.md": true,
    "/var/folders/b3/x66hsbk912qcqc4_nrlwngd40000gn/T/postman-folder-pre-request.instructions.md": true,
    "/var/folders/b3/x66hsbk912qcqc4_nrlwngd40000gn/T/postman-http-request-post-response.instructions.md": true,
    "/var/folders/b3/x66hsbk912qcqc4_nrlwngd40000gn/T/postman-http-request-pre-request.instructions.md": true,
  },
  "chat.mcp.gallery.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "chat.tools.terminal.autoApprove": {
    "daml": true,
    "dpm": true,
    "yarn v1-run-04": true,
    "git remote": true,
    "lsof": true,
    "adb": true,
    "yarn vitest": true,
    "yarn test": true,
  },
  "markdown-preview-enhanced.alwaysShowBacklinksInPreview": true,
  "markdown-preview-enhanced.enableHTML5Embed": true,
  "markdown-preview-enhanced.enableExtendedTableSyntax": true,
  "markdown-preview-enhanced.frontMatterRenderingOption": "table",
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  "editor.minimap.showSlider": "always",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "window.confirmSaveUntitledWorkspace": false,
  "github.copilot.chat.agent.autoFix": true,
  "todohighlight.isEnable": true,
  "todohighlight.keywords": [
    {
      "text": "NOTE:",
      "color": "white",
      "backgroundColor": "hsla(237, 100%, 46%, 1.00)",
      "overviewRulerColor": "grey",
    },
  ],
  "svg.preview.autoFit": false,
  "docker.extension.enableComposeLanguageServer": false,
  "git.replaceTagsWhenPull": true,
  "protobuf.formatOnSave": true,
  "notebook.formatOnSave.enabled": true,
  "githubPullRequests.pullRequestDescription": "Copilot",
  "yaml.maxItemsComputed": 50000000,
  "git.blame.statusBarItem.enabled": false,
  "git.blame.editorDecoration.enabled": true,
  "window.newWindowProfile": "Default",
  "github.copilot.chat.githubMcpServer.enabled": true,
  "githubPullRequests.pullBranch": "never",
  "chat.viewSessions.orientation": "stacked",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.env.osx": {
    "PATH": "$HOME/.nvm/versions/node/current/bin:${env:PATH}",
  },
  "extensions.ignoreRecommendations": true,
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://raw.githubusercontent.com": {
      "approveRequest": false,
      "approveResponse": true,
    },
    "https://github.com": true,
    "https://www.npmjs.com/package/openapi-ts-router": {
      "approveRequest": true,
      "approveResponse": false,
    },
    "https://docs.canton.network": true,
  },
  "js/ts.tsserver.maxMemory": 4096,
  "git.ignoreRebaseWarning": true,
  "workbench.colorTheme": "Dark Modern",
  "haskell.manageHLS": "GHCup",
  "comments.thread.confirmOnCollapse": "never",
  "update.mode": "none",
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
}
